<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Network for Gemini Live API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service so listening survives in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Screen-control (the important one - grant manually in Settings) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- New: camera, contacts lookup, and making calls -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Jarvis Lite"
        android:theme="@style/Theme.JarvisLite"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="Settings" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="Memory" />

        <!-- The accessibility service is what lets the assistant read the
             screen and tap/type on your behalf. It only runs after you
             manually enable it in Settings -> Accessibility -> Jarvis Lite. -->
        <service
            android:name=".JarvisAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Runs the whole assistant (mic + Gemini connection) as a background
             service with a persistent notification, so it keeps listening even
             if you leave the app or turn the screen off. -->
        <service
            android:name=".JarvisForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
